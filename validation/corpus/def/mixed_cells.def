VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 5000 ) ;

COMPONENTS 4 ;
- U1 INV + PLACED ( 1000 1000 ) N ;
- U2 BUF + PLACED ( 3000 1000 ) N ;
- U3 INV + PLACED ( 6000 1000 ) N ;
- U4 BUF + PLACED ( 8000 1000 ) N ;
END COMPONENTS

NETS 3 ;
- n1 ( U1 Y ) ( U2 A ) ;
- n2 ( U2 Y ) ( U3 A ) ;
- n3 ( U3 Y ) ( U4 A ) ;
END NETS

END DESIGN
