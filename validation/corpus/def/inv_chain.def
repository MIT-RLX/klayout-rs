VERSION 5.7 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;

COMPONENTS 3 ;
- U1 INV + PLACED ( 1000 1000 ) N ;
- U2 INV + PLACED ( 3000 1000 ) N ;
- U3 INV + PLACED ( 5000 1000 ) N ;
END COMPONENTS

NETS 2 ;
- net1 ( U1 Y ) ( U2 A ) ;
- net2 ( U2 Y ) ( U3 A ) ;
END NETS

END DESIGN
