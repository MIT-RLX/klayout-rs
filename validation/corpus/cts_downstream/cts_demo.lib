/** Minimal Liberty paired with validation/corpus/cts_downstream macros (BUF, DFF). */

library(cts_demo) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  capacitive_load_unit (1, ff);
  slew_derate_from_library : 1.0;
  nominal_process : 1;
  nominal_voltage : 1.0;
  nominal_temperature : 25;

  lu_table_template(delay_template_8x8) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.05, 0.1, 0.2") ;
    index_2 ("1, 4, 16, 64") ;
  }

  cell(BUF) {
    area : 2.0;
    pin(A) {
      direction : input;
      capacitance : 0.10;
    }
    pin(Y) {
      direction : output;
      function : "A";
      max_capacitance : 50.0;
      max_transition : 2.50;
      timing() {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise(delay_template_8x8) {
          values ( \
            "0.05, 0.06, 0.08, 0.10",\
            "0.07, 0.08, 0.09, 0.12",\
            "0.09, 0.10, 0.12, 0.15",\
            "0.12, 0.14, 0.16, 0.20");
        }
        cell_fall(delay_template_8x8) {
          values ( \
            "0.05, 0.06, 0.08, 0.10",\
            "0.07, 0.08, 0.09, 0.12",\
            "0.09, 0.10, 0.12, 0.15",\
            "0.12, 0.14, 0.16, 0.20");
        }
        rise_transition(delay_template_8x8) {
          values ( \
            "0.04, 0.05, 0.06, 0.08",\
            "0.05, 0.06, 0.07, 0.09",\
            "0.06, 0.07, 0.08, 0.10",\
            "0.08, 0.09, 0.11, 0.14");
        }
        fall_transition(delay_template_8x8) {
          values ( \
            "0.04, 0.05, 0.06, 0.08",\
            "0.05, 0.06, 0.07, 0.09",\
            "0.06, 0.07, 0.08, 0.10",\
            "0.08, 0.09, 0.11, 0.14");
        }
      }
    }
  }

  cell(DFF) {
    area : 4.0;
    pin(D)  { direction : input; capacitance : 0.30; }
    pin(CK) { direction : input; capacitance : 0.50; clock : true; }
    pin(Q) {
      direction : output;
      max_capacitance : 15.0;
      timing () {
        related_pin : "CK";
        timing_type : rising_edge;
        cell_rise(delay_template_8x8) {
          values ( \
            "0.10, 0.11, 0.13, 0.16",\
            "0.12, 0.13, 0.15, 0.18",\
            "0.14, 0.15, 0.17, 0.21",\
            "0.18, 0.19, 0.22, 0.26");
        }
        cell_fall(delay_template_8x8) {
          values ( \
            "0.10, 0.11, 0.13, 0.16",\
            "0.12, 0.13, 0.15, 0.18",\
            "0.14, 0.15, 0.17, 0.21",\
            "0.18, 0.19, 0.22, 0.26");
        }
        rise_transition(delay_template_8x8) {
          values ( \
            "0.04, 0.05, 0.06, 0.08",\
            "0.05, 0.06, 0.07, 0.09",\
            "0.06, 0.07, 0.08, 0.10",\
            "0.08, 0.09, 0.11, 0.14");
        }
        fall_transition(delay_template_8x8) {
          values ( \
            "0.04, 0.05, 0.06, 0.08",\
            "0.05, 0.06, 0.07, 0.09",\
            "0.06, 0.07, 0.08, 0.10",\
            "0.08, 0.09, 0.11, 0.14");
        }
      }
    }
  }
}

