VERSION 5.8 ;
NAMESCASESENSITIVE OFF ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;

DESIGN ctsfour ;
UNITS DISTANCE MICRONS 1000 ;

DIEAREA ( 0 0 ) ( 20000 12000 ) ;

COMPONENTS 4 ;
- FF0 DFF + PLACED ( 2000 2000 ) N ;
- FF1 DFF + PLACED ( 15000 2000 ) N ;
- FF2 DFF + PLACED ( 2000 9000 ) N ;
- FF3 DFF + PLACED ( 15000 9000 ) N ;
END COMPONENTS

PINS 1 ;
- clk + NET clk + DIRECTION INPUT + USE CLOCK
 + LAYER metal2 ( -200 -100 ) ( 200 100 ) + FIXED ( 8500 -500 ) N ;
END PINS

NETS 1 ;
- clk ( PIN clk ) ( FF0 CK ) ( FF1 CK ) ( FF2 CK ) ( FF3 CK ) ;
END NETS

END DESIGN
