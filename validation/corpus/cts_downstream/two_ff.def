VERSION 5.8 ;
NAMESCASESENSITIVE OFF ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;

DESIGN ctstwo ;
UNITS DISTANCE MICRONS 1000 ;

DIEAREA ( 0 0 ) ( 20000 20000 ) ;

COMPONENTS 2 ;
- FF1 DFF + PLACED ( 1000 1000 ) N ;
- FF2 DFF + PLACED ( 10000 1000 ) N ;
END COMPONENTS

PINS 1 ;
- clk + NET clk + DIRECTION INPUT + USE CLOCK
 + LAYER metal2 ( -200 -100 ) ( 200 100 ) + FIXED ( 5550 -500 ) N ;
END PINS

NETS 1 ;
- clk ( PIN clk ) ( FF1 CK ) ( FF2 CK ) ;
END NETS

END DESIGN
